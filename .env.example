# Copy to .env and fill in. .env is gitignored.

# Short KIT account (e.g. ab1234), NOT your e-mail address.
KIT_USERNAME=
KIT_PASSWORD=

# Optional: pin a degree programme GUID instead of auto-detecting it.
# Run `kit-campus login` to see the GUIDs on your account.
KIT_PROGRAM_GUID=

# Optional: de (default) or en - affects notification wording.
KIT_LANGUAGE=de

# Optional: HTTP timeout in seconds.
KIT_TIMEOUT=45

# Optional: where cookies and snapshots are stored.
# Defaults to %LOCALAPPDATA%\kit-campus-mcp
KIT_CAMPUS_STATE_DIR=

# Telegram bot (only needed for examples/telegram_bot.py)
TELEGRAM_BOT_TOKEN=
# One chat id, or several separated by commas, or a group id (negative number)
# to reach a whole study group. Anyone in a listed chat can also run /noten,
# which shows your grades - only list chats you are happy to share those with.
TELEGRAM_CHAT_ID=
